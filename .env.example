
# Database
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=course_management;User=your_db_user;Password=your_db_password

# Email Security
HMAC_EMAIL_SECRET=your_base64_hmac_secret
EMAIL_ENCRYPTION_KEY=your_base64_encryption_key

# JWT Authentication
JWT_ACCESS_SECRET=your_base64_access_secret
JWT_REFRESH_SECRET=your_base64_refresh_secret

# Admin Seeding (only if implemented later)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
